@model Subaston.ViewsModels.LoginViewsModels
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/cuenta-css/login.css" />
</head>
<body>

    <div class="mi-navbar">
        <img class="imagen-navbar" src="~/Imagenes3/LogoFinal2-transparente.png" />
        <div class="nav-links">
            <a asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
            <a asp-area="Cuentas" asp-controller="Cuenta" asp-action="Registrar">Registro</a>
            <a asp-area="Cuentas" asp-controller="Cuenta" asp-action="Verificacion">Cambio de Contraseña</a>
            <a asp-area="Cuentas" asp-controller="Cuenta" asp-action="PoliticasPrivacidad">Políticas de Privacidad</a>
        </div>
    </div>

    <div class="layout">

        <div class="lado-izquierdo">
            <h1 class="texto-titulo">Bienvenido de Vuelta</h1>
            <p class="slogan">Tus coleccionables te esperan.</p>
            <p class="desc">
                Subaston es la plataforma donde encuentras piezas únicas que no hallarás en ningún otro lugar<br />
                Inicia sesión y sigue explorando.
            </p>
        </div>

        <div class="login-container">
            <h2>Iniciar Sesión</h2>

            <form asp-action="Login" method="post">

                <div class="form-group">
                    <label>Correo</label>
                    <input asp-for="Correo" placeholder="Ingresa tu correo" />
                    <span asp-validation-for="Correo" class="validation"></span>
                </div>

                <div class="form-group">
                    <label>Contraseña</label>
                    <input asp-for="Contraseña" type="password" placeholder="Ingresa tu contraseña" />
                    <span asp-validation-for="Contraseña" class="validation"></span>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div style="background:#3a0a0a; border:1px solid #ff4d4d; border-radius:8px; padding:10px 14px; color:#ff6b6b; font-size:14px; margin-bottom:12px;">
                        ❌ @ViewBag.Error
                        @if (ViewBag.ReenviarCorreo != null)
                        {
                            <a href="@Url.Action("ReenviarVerificacion", "Cuenta", new { area = "Cuentas", correo = ViewBag.ReenviarCorreo })" style="color: #00B8D9; text-decoration: underline; font-weight: bold;">reenviarlo aquí</a>
                        }
                    </div>
                }
                @if (TempData["Correcto"] != null)
                {
                    <div style="background:#0a3a1a; border:1px solid #28a745; border-radius:8px; padding:10px 14px; color:#5cb85c; font-size:14px; margin-bottom:12px;">
                        ✅ @TempData["Correcto"]
                    </div>
                }
                <button type="submit" class="btn-verificar">Entrar</button>

                <div style="display: flex; gap: 12px; margin-top: 12px; justify-content: center;">
                    <a asp-area="Cuentas" asp-controller="Cuenta" asp-action="Registrar" class="btn-principal">Registro</a>
                    <a asp-area="Cuentas" asp-controller="Cuenta" asp-action="Verificacion" class="btn-secundario">¿Olvidaste tu contraseña?</a>
                </div>

            </form>
        </div>

    </div>
</body>
</html>