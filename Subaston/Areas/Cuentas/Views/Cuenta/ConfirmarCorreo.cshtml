@model dynamic
@{
    ViewData["Title"] = "Confirmar Correo";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/cuenta-css/login.css" />
</head>
<body>

    <div class="mi-navbar">
        <img class="imagen-navbar" src="~/Imagenes3/LogoFinal2-transparente.png" />
        <div class="nav-links">
            <a asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
            <a asp-area="Cuentas" asp-controller="Cuenta" asp-action="Login">Iniciar Sesión</a>
            <a asp-area="Cuentas" asp-controller="Cuenta" asp-action="PoliticasPrivacidad">Políticas de Privacidad</a>
        </div>
    </div>

    <div class="layout" style="justify-content: center; display: flex; align-items: center; min-height: calc(100vh - 60px);">
        <div class="login-container" style="max-width: 500px; width: 100%; margin: 0 auto; box-sizing: border-box;">
            <h2>Confirmación de Cuenta</h2>
            <p style="color: #d1d5db; margin-bottom: 25px; line-height: 1.6; font-size: 15px;">
                Estás a un paso de activar tu cuenta de **Subaston**. Por favor, haz clic en el botón de abajo para verificar tu dirección de correo electrónico y empezar a participar en las subastas.
            </p>

            <form asp-action="ConfirmarCorreoPost" method="post">
                <input type="hidden" name="correo" value="@ViewBag.Correo" />
                <input type="hidden" name="token" value="@ViewBag.Token" />

                <button type="submit" class="btn-verificar" style="margin-bottom: 15px; width: 100%;">Activar Mi Cuenta</button>
            </form>

            <div style="margin-top: 15px;">
                <a asp-area="Cuentas" asp-controller="Cuenta" asp-action="Login" style="color: #00B8D9; text-decoration: none; font-size: 14px; font-weight: bold;">Volver a Iniciar Sesión</a>
            </div>
        </div>
    </div>
</body>
</html>
