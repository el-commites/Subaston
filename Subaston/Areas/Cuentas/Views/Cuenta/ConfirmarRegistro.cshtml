@model dynamic
@{
    ViewData["Title"] = "Completar Registro";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/cuenta-css/login.css" />
</head>
<body>

    <div class="mi-navbar">
        <img class="imagen-navbar" src="~/Imagenes3/LogoFinal2-transparente.png" />
        <div class="nav-links">
            <a asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
            <a asp-area="Cuentas" asp-controller="Cuenta" asp-action="Login">Iniciar Sesión</a>
            <a asp-area="Cuentas" asp-controller="Cuenta" asp-action="PoliticasPrivacidad">Políticas de Privacidad</a>
        </div>
    </div>

    <div class="layout" style="justify-content: center; display: flex; align-items: center; min-height: calc(100vh - 60px);">
        <div class="login-container" style="max-width: 500px; width: 100%; margin: 0 auto; box-sizing: border-box;">
            <h2>¡Hola @ViewBag.Nombre!</h2>
            <h2>Completar Registro</h2>
            <p style="color: #d1d5db; margin-bottom: 25px; line-height: 1.6; font-size: 15px;">
                Tu dirección de correo electrónico ha sido validada con éxito. Por favor, haz clic en el botón de abajo para finalizar el registro y crear tu cuenta de **Subaston**.
            </p>

            <form asp-action="ConfirmarRegistroPost" method="post">
                <input type="hidden" name="datos" value="@ViewBag.Datos" />

                <button type="submit" class="btn-verificar" style="margin-bottom: 15px; width: 100%;">Completar Registro y Crear Cuenta</button>
            </form>

            <div style="margin-top: 15px;">
                <a asp-area="Cuentas" asp-controller="Cuenta" asp-action="Login" style="color: #00B8D9; text-decoration: none; font-size: 14px; font-weight: bold;">Volver a Iniciar Sesión</a>
            </div>
        </div>
    </div>
</body>
</html>
